#!/usr/bin/env bash

# This file is sourced by the RDK setup flow, so use return when possible while
# retaining a safe exit fallback for accidental direct execution.
rdk_filogic_fail() {
    echo "ERROR: $*" >&2
    return 1 2>/dev/null || exit 1
}

rdk_filogic_add_layer() {
    local layer_name="$1"
    local layer_path="${RDKROOT}/${layer_name}"

    [ -d "${layer_path}" ] || return 0

    if ! grep -Fq "\"${layer_path}\"" conf/bblayers.conf; then
        cat >> conf/bblayers.conf <<EOF
BBLAYERS += " ${layer_path}"
EOF
    fi
}

unset _RDK_FLAVOR

TOP_DIR="$(pwd)"
export RDK_BSP_LAYER="meta-cmf-filogic"

source meta-cmf/setup-environment "$1" || return 1

# meta-cmf/setup-environment changes into the build directory.
BUILD_DIR="$(pwd)"
_RDK_FLAVOR="rdkb"

rdk_filogic_add_layer "meta-cmf-filogic"
rdk_filogic_add_layer "meta-filogic"
rdk_filogic_add_layer "meta-filogic-logan"
rdk_filogic_add_layer "meta-rdk-wan"
rdk_filogic_add_layer "meta-amx"
rdk_filogic_add_layer "meta-prplmesh"

if [ -L "${TOP_DIR}/.repo/manifest.xml" ]; then
    MANIFEST="$(basename "$(readlink -f "${TOP_DIR}/.repo/manifest.xml")" .xml)"
else
    MANIFEST="$(grep include "${TOP_DIR}/.repo/manifest.xml" | cut -d '"' -f 2 | xargs -r basename -s .xml)"
fi
echo "Manifest Name = ${MANIFEST}.xml"

if [ -f "${TOP_DIR}/.repo/manifests/turris-tags/${MANIFEST}.conf" ]; then
    cat "${TOP_DIR}/.repo/manifests/turris-tags/${MANIFEST}.conf" >> "${BUILD_DIR}/conf/auto.conf" ||
        rdk_filogic_fail "Unable to copy ${MANIFEST}.conf to auto.conf."
fi

BITBAKE_VERSION="$(
    sed -n 's/^__version__ = "\(.*\)"/\1/p' \
        "${TOP_DIR}/openembedded-core/bitbake/bin/bitbake"
)"

case "${BITBAKE_VERSION}" in
    2.18.*) YOCTO_CODENAME="wrynose" ;;
    2.2.*|2.0.*) YOCTO_CODENAME="kirkstone" ;;
    1.46.*) YOCTO_CODENAME="dunfell" ;;
    1.37.*|1.38.*) YOCTO_CODENAME="sumo" ;;
    1.35.*|1.36.*) YOCTO_CODENAME="rocko" ;;
    1.34.*) YOCTO_CODENAME="pyro" ;;
    1.32.*) YOCTO_CODENAME="morty" ;;
    1.30.*) YOCTO_CODENAME="krogoth" ;;
    *) rdk_filogic_fail "Unsupported BitBake version '${BITBAKE_VERSION:-unknown}'. Refusing to select a release path." ;;
esac

echo "Configured meta-cmf-filogic for Yocto release '${YOCTO_CODENAME}'."

# Do not edit tracked machine/configuration files, mutate meta-rdk recipes, or
# generate Logan hostapd patches here. Those operations make build results
# dependent on setup history and must instead be managed by their owning,
# manifest-pinned layer workflow.
